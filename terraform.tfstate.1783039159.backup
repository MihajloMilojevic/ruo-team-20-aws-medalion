    {
      "module": "module.orchestration",
      "mode": "managed",
      "type": "aws_sfn_state_machine",
      "name": "pipeline",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:states:us-east-1:989211373225:stateMachine:social-media-pipeline-dev-pipeline",
            "creation_date": "2026-07-03T00:35:26Z",
            "definition": "{\n  \"Comment\": \"Daily pipeline: ingestion -\u003e (normalization_hn || normalization_x) -\u003e analytics -\u003e delivery. The date resolved by ingestion (event date or yesterday) is threaded through every downstream step, so all steps always operate on the same day even across a midnight boundary. Failures anywhere route to NotifyFailure with the failing Lambda's full error detail.\",\n  \"StartAt\": \"Ingestion\",\n  \"TimeoutSeconds\": 1800,\n  \"States\": {\n    \"Ingestion\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-east-1:989211373225:function:social-media-pipeline-dev-ingestion\",\n        \"Payload.$\": \"$\"\n      },\n      \"ResultSelector\": {\n        \"date.$\": \"$.Payload.date\"\n      },\n      \"ResultPath\": \"$.ingestion\",\n      \"TimeoutSeconds\": 360,\n      \"Retry\": [\n        {\n          \"ErrorEquals\": [\n            \"Lambda.ServiceException\",\n            \"Lambda.AWSLambdaException\",\n            \"Lambda.SdkClientException\",\n            \"Lambda.TooManyRequestsException\"\n          ],\n          \"IntervalSeconds\": 5,\n          \"MaxAttempts\": 3,\n          \"BackoffRate\": 2.0\n        }\n      ],\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"ResultPath\": \"$.error\",\n          \"Next\": \"IngestionFailed\"\n        }\n      ],\n      \"Next\": \"Normalization\"\n    },\n\n    \"Normalization\": {\n      \"Type\": \"Parallel\",\n      \"ResultPath\": \"$.normalization\",\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"ResultPath\": \"$.error\",\n          \"Next\": \"NormalizationFailed\"\n        }\n      ],\n      \"Branches\": [\n        {\n          \"StartAt\": \"NormalizationHN\",\n          \"States\": {\n            \"NormalizationHN\": {\n              \"Type\": \"Task\",\n              \"Resource\": \"arn:aws:states:::lambda:invoke\",\n              \"Parameters\": {\n                \"FunctionName\": \"arn:aws:lambda:us-east-1:989211373225:function:social-media-pipeline-dev-normalization-hn\",\n                \"Payload\": {\n                  \"date.$\": \"$.ingestion.date\"\n                }\n              },\n              \"ResultSelector\": {\n                \"result.$\": \"$.Payload\"\n              },\n              \"TimeoutSeconds\": 360,\n              \"Retry\": [\n                {\n                  \"ErrorEquals\": [\n                    \"Lambda.ServiceException\",\n                    \"Lambda.AWSLambdaException\",\n                    \"Lambda.SdkClientException\",\n                    \"Lambda.TooManyRequestsException\"\n                  ],\n                  \"IntervalSeconds\": 5,\n                  \"MaxAttempts\": 3,\n                  \"BackoffRate\": 2.0\n                }\n              ],\n              \"End\": true\n            }\n          }\n        },\n        {\n          \"StartAt\": \"NormalizationX\",\n          \"States\": {\n            \"NormalizationX\": {\n              \"Type\": \"Task\",\n              \"Resource\": \"arn:aws:states:::lambda:invoke\",\n              \"Parameters\": {\n                \"FunctionName\": \"arn:aws:lambda:us-east-1:989211373225:function:social-media-pipeline-dev-normalization-x\",\n                \"Payload\": {\n                  \"date.$\": \"$.ingestion.date\"\n                }\n              },\n              \"ResultSelector\": {\n                \"result.$\": \"$.Payload\"\n              },\n              \"TimeoutSeconds\": 360,\n              \"Retry\": [\n                {\n                  \"ErrorEquals\": [\n                    \"Lambda.ServiceException\",\n                    \"Lambda.AWSLambdaException\",\n                    \"Lambda.SdkClientException\",\n                    \"Lambda.TooManyRequestsException\"\n                  ],\n                  \"IntervalSeconds\": 5,\n                  \"MaxAttempts\": 3,\n                  \"BackoffRate\": 2.0\n                }\n              ],\n              \"End\": true\n            }\n          }\n        }\n      ],\n      \"Next\": \"Analytics\"\n    },\n\n    \"Analytics\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-east-1:989211373225:function:social-media-pipeline-dev-analytics\",\n        \"Payload\": {\n          \"date.$\": \"$.ingestion.date\"\n        }\n      },\n      \"ResultSelector\": {\n        \"result.$\": \"$.Payload\"\n      },\n      \"ResultPath\": \"$.analytics\",\n      \"TimeoutSeconds\": 360,\n      \"Retry\": [\n        {\n          \"ErrorEquals\": [\n            \"Lambda.ServiceException\",\n            \"Lambda.AWSLambdaException\",\n            \"Lambda.SdkClientException\",\n            \"Lambda.TooManyRequestsException\"\n          ],\n          \"IntervalSeconds\": 5,\n          \"MaxAttempts\": 3,\n          \"BackoffRate\": 2.0\n        }\n      ],\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"ResultPath\": \"$.error\",\n          \"Next\": \"AnalyticsFailed\"\n        }\n      ],\n      \"Next\": \"Delivery\"\n    },\n\n    \"Delivery\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-east-1:989211373225:function:social-media-pipeline-dev-delivery\",\n        \"Payload\": {\n          \"date.$\": \"$.ingestion.date\"\n        }\n      },\n      \"ResultSelector\": {\n        \"result.$\": \"$.Payload\"\n      },\n      \"ResultPath\": \"$.delivery\",\n      \"TimeoutSeconds\": 360,\n      \"Retry\": [\n        {\n          \"ErrorEquals\": [\n            \"Lambda.ServiceException\",\n            \"Lambda.AWSLambdaException\",\n            \"Lambda.SdkClientException\",\n            \"Lambda.TooManyRequestsException\"\n          ],\n          \"IntervalSeconds\": 5,\n          \"MaxAttempts\": 3,\n          \"BackoffRate\": 2.0\n        }\n      ],\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"ResultPath\": \"$.error\",\n          \"Next\": \"DeliveryFailed\"\n        }\n      ],\n      \"End\": true\n    },\n\n    \"IngestionFailed\": {\n      \"Type\": \"Pass\",\n      \"Result\": \"Ingestion\",\n      \"ResultPath\": \"$.failed_step\",\n      \"Next\": \"NotifyFailure\"\n    },\n    \"NormalizationFailed\": {\n      \"Type\": \"Pass\",\n      \"Result\": \"Normalization (HN or X)\",\n      \"ResultPath\": \"$.failed_step\",\n      \"Next\": \"NotifyFailure\"\n    },\n    \"AnalyticsFailed\": {\n      \"Type\": \"Pass\",\n      \"Result\": \"Analytics\",\n      \"ResultPath\": \"$.failed_step\",\n      \"Next\": \"NotifyFailure\"\n    },\n    \"DeliveryFailed\": {\n      \"Type\": \"Pass\",\n      \"Result\": \"Delivery\",\n      \"ResultPath\": \"$.failed_step\",\n      \"Next\": \"NotifyFailure\"\n    },\n\n    \"NotifyFailure\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-east-1:989211373225:function:social-media-pipeline-dev-notification\",\n        \"Payload\": {\n          \"failed_step.$\": \"$.failed_step\",\n          \"error.$\": \"$.error.Error\",\n          \"cause.$\": \"$.error.Cause\",\n          \"execution.$\": \"$$.Execution.Name\",\n          \"state_machine.$\": \"$$.StateMachine.Name\"\n        }\n      },\n      \"TimeoutSeconds\": 60,\n      \"Retry\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"IntervalSeconds\": 5,\n          \"MaxAttempts\": 2,\n          \"BackoffRate\": 2.0\n        }\n      ],\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"ResultPath\": \"$.notify_error\",\n          \"Next\": \"PipelineFailed\"\n        }\n      ],\n      \"Next\": \"PipelineFailed\"\n    },\n\n    \"PipelineFailed\": {\n      \"Type\": \"Fail\",\n      \"Error\": \"PipelineFailed\",\n      \"Cause\": \"A pipeline step failed - see the execution history and the Discord notification for details\"\n    }\n  }\n}\n",
            "description": "",
